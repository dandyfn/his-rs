APP_NAME="Ini Rumah Sakit"
# APP_TAGLINE="Datang Karena Sakit, Pulang Karena Ga Kuat Bayar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# DATABASE
# Untuk mengembangkan fitur: pakai SQLite lokal (aman, data sendiri).
#   1) buat file kosong database/database.sqlite
#   2) php artisan migrate:fresh --seed
# JANGAN arahkan ke database Aiven saat mengembangkan: database itu
# dipakai web demo di Render, dan migrate:fresh akan menghapus datanya.
# ---------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Contoh pengaturan PostgreSQL (Aiven) — hanya untuk pemilik deploy, isi dari Aiven:
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_PERSISTENT=true
# DB_EMULATE_PREPARES=true

# Batas hari peringatan kedaluwarsa obat (FR-07)
BATAS_KEDALUWARSA_HARI=90

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
